# Django — local development
DJANGO_SETTINGS_MODULE=chamaplus_backend.settings.development
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL — local XAMPP (uncomment to use locally; comment Aiven block below)
DB_ENGINE=django.db.backends.mysql
DB_NAME=chamaplus_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# MySQL — Aiven (remote; comment XAMPP block above when using this)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=
# DB_HOST=mysql-xxxxx.c.aivencloud.com
# DB_PORT=17962
# DB_SSL_MODE=REQUIRED
# DB_SSL_CA=certs/aiven-ca.pem

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Media / Static
MEDIA_URL=/media/
STATIC_URL=/static/

# Optional app tuning (defaults exist in settings if omitted)
# MIN_CONTRIBUTIONS_FOR_LOAN_ELIGIBILITY=1
# LOAN_VOTE_APPROVAL_THRESHOLD=0.51
# CS_WEIGHT_CONSISTENCY=0.35
# CS_WEIGHT_REPAYMENT=0.35
# CS_WEIGHT_ATTENDANCE=0.15
# CS_WEIGHT_DURATION=0.15
# CS_RISK_EXCELLENT=80
# CS_RISK_GOOD=60
# CS_RISK_FAIR=40

# ---------------------------------------------------------------------------
# RENDER — set these in Render → Environment (do not commit real secrets)
# ---------------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE=chamaplus_backend.settings.production
# SECRET_KEY=
# DEBUG=False
# ALLOWED_HOSTS=your-service.onrender.com,.onrender.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=
# DB_HOST=mysql-xxxxx.c.aivencloud.com
# DB_PORT=17962
# DB_SSL_MODE=REQUIRED
# CORS_ALLOWED_ORIGINS=
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# MEDIA_URL=/media/
# STATIC_URL=/static/
# MIN_CONTRIBUTIONS_FOR_LOAN_ELIGIBILITY=1
# LOAN_VOTE_APPROVAL_THRESHOLD=0.51
# CS_WEIGHT_CONSISTENCY=0.35
# CS_WEIGHT_REPAYMENT=0.35
# CS_WEIGHT_ATTENDANCE=0.15
# CS_WEIGHT_DURATION=0.15
# CS_RISK_EXCELLENT=80
# CS_RISK_GOOD=60
# CS_RISK_FAIR=40
