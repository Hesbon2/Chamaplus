# Used automatically for debug / profile builds (or --dart-define=APP_ENV=development).
# Android emulator: 127.0.0.1 is rewritten to 10.0.2.2 at runtime.
# Physical device: override with --dart-define=API_BASE_URL=http://YOUR_LAN_IP:8000/api/v1
API_BASE_URL=http://127.0.0.1:8000/api/v1
API_CONNECT_TIMEOUT_MS=15000
API_RECEIVE_TIMEOUT_MS=15000
