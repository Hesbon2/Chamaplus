# Optional local override file (gitignored). Prefer .env.development / .env.production.
# Env is selected automatically:
#   debug/profile → .env.development
#   release       → .env.production
# Force with: flutter run --dart-define=APP_ENV=production
#
# Android emulator: leave 127.0.0.1 — rewritten to 10.0.2.2 automatically.
# iOS Simulator / desktop: http://127.0.0.1:8000/api/v1
# Physical device: http://YOUR_LAN_IP:8000/api/v1
API_BASE_URL=http://127.0.0.1:8000/api/v1
API_CONNECT_TIMEOUT_MS=15000
API_RECEIVE_TIMEOUT_MS=15000
